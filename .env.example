# ==========================================
# MoiDoctar Frontend Environment Variables
# ==========================================

# Base URL for the FastAPI Backend API in production (must end with /api/v1)
VITE_API_BASE_URL=https://moidoctar.pxxl.click/api/v1

# Model / Triage API URL (usually identical to VITE_API_BASE_URL)
VITE_MODEL_API_URL=https://moidoctar.pxxl.click/api/v1

# Google Sign-In OAuth Client ID (from Google Cloud Console)
# Note: Must match GOOGLE_CLIENT_ID configured on the backend!
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional App Branding
VITE_APP_NAME=MoiDoctar
