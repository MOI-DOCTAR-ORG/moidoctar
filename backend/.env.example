# ==========================================
# MoiDoctar Backend Environment Configuration
# ==========================================

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# JWT Security
SECRET_KEY=moidoctar-super-secret-jwt-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Google Sign-In (from Google Cloud Console -> APIs & Services -> Credentials).
# Must be the SAME client id used by the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Cencori AI gateway (AIB Ship). Get a key at https://cencori.com (Project > API Keys).
# When set, all AI calls go through Cencori (logs, security filters, cost tracking) and
# fall back to Gemini directly if the gateway fails. Leave blank to call Gemini directly.
CENCORI_API_KEY=
CENCORI_BASE_URL=https://api.cencori.com
CENCORI_CHAT_PATH=/api/ai/chat
CENCORI_MODEL=gemini-2.5-flash

# Google Gemini (fallback when Cencori is off or down). Key from Google AI Studio.
# Add as many keys as you like. Extra keys can also be added later from the app
# (Profile -> AI settings, admins only). Requests rotate across keys and skip any
# that are rate-limited or invalid.
GOOGLE_API_KEY=
GOOGLE_API_KEYS=
GEMINI_MODEL=gemini-flash-latest

# Byteship (AIB Ship): storage + CDN for profile photos. Get a key at https://byteship.dev
# (bship_...). SERVER-SIDE ONLY. When set, avatars are stored on Byteship, falling back to
# Cloudinary / inline data URL if it fails. Leave blank to skip Byteship.
BYTESHIP_API_KEY=
BYTESHIP_BASE_URL=https://api.byteship.dev

# Comma-separated emails allowed to manage AI keys in the app
ADMIN_EMAILS=

# Resend Email Configuration (Recommended for OTP & Verification Emails)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="MoiDoctar <onboarding@resend.dev>"

# SMTP Fallback (optional - used only if RESEND_API_KEY is not set)
# If both Resend and SMTP are left blank, OTP codes are logged to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://moidoctar8.pxxlspace.cv,https://moidoctar.vercel.app

# Server Port
PORT=3000
HOST=0.0.0.0
