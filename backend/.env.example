# ==========================================
# MoiDoctar Backend Environment Configuration
# ==========================================

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# JWT Security
SECRET_KEY=moidoctar-super-secret-jwt-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Google Sign-In (from Google Cloud Console -> APIs & Services -> Credentials).
# Must be the SAME client id used by the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# SMTP (sends OTP codes for email verification + password reset).
# If left blank, OTP codes are logged to the backend console instead of
# emailed, so signup/verify/reset still work end-to-end in local dev.
# Example values for a Gmail account using an App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://moidoctar8.pxxlspace.cv,https://moidoctar.vercel.app

# Server Port
PORT=8000
HOST=0.0.0.0
