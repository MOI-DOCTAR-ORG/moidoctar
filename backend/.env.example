# ==========================================
# MoiDoctar Backend Environment Configuration
# ==========================================

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# JWT Security
SECRET_KEY=moidoctar-super-secret-jwt-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Google Sign-In (from Google Cloud Console -> APIs & Services -> Credentials).
# Must be the SAME client id used by the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Gemini AI Triage (from Google AI Studio / Makersuite)
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Port
PORT=8000
HOST=0.0.0.0
