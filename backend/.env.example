# ==========================================
# MoiDoctar Backend Environment Configuration
# ==========================================

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# JWT Security
SECRET_KEY=moidoctar-super-secret-jwt-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Google Sign-In (from Google Cloud Console -> APIs & Services -> Credentials).
# Must be the SAME client id used by the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Gemini AI Triage (API Key from Google AI Studio)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Resend Email Configuration (Recommended for OTP & Verification Emails)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="MoiDoctar <onboarding@resend.dev>"

# SMTP Fallback (optional - used only if RESEND_API_KEY is not set)
# If both Resend and SMTP are left blank, OTP codes are logged to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://moidoctar8.pxxlspace.cv,https://moidoctar.vercel.app

# Server Port
PORT=3000
HOST=0.0.0.0
